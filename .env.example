# Supabase — copy file này thành .env (chạy tại chỗ) và nhập 2 giá trị này
# vào Vercel → Project → Settings → Environment Variables rồi Redeploy.
# Lấy ở Supabase Dashboard → Project Settings → API.
# KHÔNG commit file .env thật lên GitHub (chỉ có anon key, không phải service_role key).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
